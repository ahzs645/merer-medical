{
  "name": "@mere/immunization-forecast",
  "version": "0.0.0",
  "private": false,
  "description": "TypeScript immunization forecasting engine for Mere.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./ice": {
      "types": "./dist/ice.d.ts",
      "import": "./dist/ice.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "date-fns": "^2.29.1",
    "fast-xml-parser": "^5.8.0",
    "yaml": "^2.8.2"
  }
}
