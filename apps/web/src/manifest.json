{
  "short_name": "Mere",
  "name": "Mere Medical",
  "description": "Personal Medical Record Management",
  "icons": [
    {
      "src": "assets/icon/icon-1024.png",
      "type": "image/png",
      "sizes": "1024x1024",
      "purpose": "any maskable"
    },
    {
      "src": "assets/icon/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "start_url": ".",
  "background_color": "#006183",
  "display": "standalone",
  "theme_color": "#006183",
  "prefer_related_applications": false,
  "file_handlers": [
    {
      "action": ".",
      "accept": {
        "application/x-mere-emrpkg": [".emrpkg"]
      }
    }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "package",
          "accept": [
            ".emrpkg",
            "application/x-mere-emrpkg",
            "application/octet-stream",
            "application/zip"
          ]
        }
      ]
    }
  }
}
